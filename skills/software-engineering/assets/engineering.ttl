    rdfs:domain nx:Skill ;
    rdfs:range nx:Artifact .

nx:context-engineering a nx:Skill ;
    nx:appliesInPhase nx:phase-build,
        nx:phase-define,
        nx:phase-plan,
        nx:phase-review,
        nx:phase-ship,
        nx:phase-verify ;
    nx:derivedFrom nx:addy ;
    nx:id "context-engineering" ;
    nx:implementsCapability nx:capability-context-engineering ;
    nx:ownedBy nx:role-orchestrator ;
    nx:sourceHash "8b736cb9e55b82b265ab6ff78349c0e826e8a6df550deddf665b7fb3ff858b63" ;
    nx:summary "Select current contracts and source, protect live constraints and persist restartable boundaries." ;
    nx:workflowPath "references/upstream/skills/context-engineering/workflow.md" .

nx:context-packet a nx:ContextPacket .

nx:contextHash a owl:DatatypeProperty,
        owl:FunctionalProperty .

nx:decision a nx:Decision .

nx:dependsOn a owl:ObjectProperty ;
    rdfs:domain nx:Artifact ;
    rdfs:range nx:Artifact .

nx:derivedFrom a owl:ObjectProperty ;
    rdfs:domain nx:Skill ;
    rdfs:range nx:Source .

nx:existing-stack a nx:ProjectProfile ;
    nx:constrainedBy nx:policy-authorization,
        nx:policy-budget-integrity,
        nx:policy-evidence-honesty,
        nx:policy-preserve-stack,
        nx:policy-real-integration,
        nx:policy-selective-context ;
    nx:profileId "existing-stack" .

nx:forPhase a owl:ObjectProperty ;
    rdfs:domain nx:RoutingRule ;
    rdfs:range nx:Phase .

nx:gate-performance a nx:Gate ;
