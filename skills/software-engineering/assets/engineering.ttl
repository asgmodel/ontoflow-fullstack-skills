    nx:workflowPath "references/upstream/skills/git-workflow-and-versioning/workflow.md" .

nx:hasRoot a owl:ObjectProperty ;
    rdfs:domain nx:Intent ;
    rdfs:range nx:Skill .

nx:id a owl:DatatypeProperty,
        owl:FunctionalProperty .

