@prefix nx: <urn:software-engineering:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

nx:Ontology a owl:Ontology ;
    rdfs:comment "Software Engineering Full-Stack Engineering Ontology. Routing metadata supports selective workflow loading; it does not execute application development or certify correctness." ;
    owl:versionInfo "2.0.0" .

nx:Risk a owl:Class ;
    rdfs:label "Risk" .

nx:Task a owl:Class ;
    rdfs:label "Task" .

nx:activatesSkill a owl:ObjectProperty ;
    rdfs:domain nx:RoutingRule ;
    rdfs:range nx:Skill .

nx:appliesInPhase a owl:ObjectProperty ;
    rdfs:domain nx:Skill ;
    rdfs:range nx:Phase .

nx:budgetTokens a owl:DatatypeProperty .

nx:code-simplification a nx:Skill ;
    nx:appliesInPhase nx:phase-build,
        nx:phase-review ;
    nx:derivedFrom nx:addy ;
    nx:id "code-simplification" ;
    nx:implementsCapability nx:capability-code-simplification ;
    nx:ownedBy nx:role-architect ;
    nx:sourceHash "f0c5ed754057eb0c1e027e2587f59de816651feb5e837242296c43ea21cf621d" ;
    nx:summary "Reduce complexity while preserving proven behavior and error handling." ;
    nx:workflowPath "references/upstream/skills/code-simplification/workflow.md" .

nx:command a owl:DatatypeProperty .

