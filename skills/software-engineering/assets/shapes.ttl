@prefix nx: <urn:software-engineering:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nx:SkillShape a sh:NodeShape ; sh:targetClass nx:Skill ;
 sh:property [ sh:path nx:id ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ] ;
 sh:property [ sh:path nx:summary ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
 sh:property [ sh:path nx:workflowPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
 sh:property [ sh:path nx:sourceHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[a-f0-9]{64}$" ] ;
 sh:property [ sh:path nx:appliesInPhase ; sh:minCount 1 ; sh:class nx:Phase ] ;
 sh:property [ sh:path nx:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class nx:Role ] ;
 sh:property [ sh:path nx:derivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class nx:Source ] ;
 sh:property [ sh:path nx:requiresSkill ; sh:class nx:Skill ] ;
 sh:sparql [ sh:message "Skill id must be unique." ; sh:select """
 PREFIX nx: <urn:software-engineering:>
 SELECT $this WHERE { $this nx:id ?id . ?other a nx:Skill ; nx:id ?id . FILTER (?other != $this) }
 """ ] .

nx:RoutingRuleShape a sh:NodeShape ; sh:targetClass nx:RoutingRule ;
 sh:property [ sh:path nx:id ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
 sh:property [ sh:path nx:forPhase ; sh:minCount 1 ; sh:maxCount 1 ; sh:class nx:Phase ] ;
 sh:property [ sh:path nx:activatesSkill ; sh:minCount 1 ; sh:maxCount 1 ; sh:class nx:Skill ] ;
 sh:property [ sh:path nx:requiredTag ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
 sh:property [ sh:path nx:requiredLayer ; sh:maxCount 1 ; sh:datatype xsd:string ] .

nx:APIContractShape a sh:NodeShape ; sh:targetClass nx:APIContract ;
 sh:property [ sh:path nx:verifiedBy ; sh:minCount 1 ; sh:class nx:Gate ] .

# Apply this shape to the project instance graph when it contains Evidence.
# No VERIFIED evidence is fabricated in the catalog ontology.
nx:EvidenceShape a sh:NodeShape ; sh:targetClass nx:Evidence ;
 sh:property [ sh:path nx:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "VERIFIED" "NOT VERIFIED" "BLOCKED BY ENVIRONMENT" ) ] ;
 sh:property [ sh:path nx:command ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:property [ sh:path nx:result ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:property [ sh:path nx:testedRevision ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
 sh:sparql [ sh:message "VERIFIED evidence requires command/action, actual result and tested revision." ; sh:select """
 PREFIX nx: <urn:software-engineering:>
 SELECT $this WHERE {
   $this nx:status "VERIFIED" .
   FILTER (NOT EXISTS { $this nx:command ?command ; nx:result ?result ; nx:testedRevision ?revision })
 }
 """ ] .
